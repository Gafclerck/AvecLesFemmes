{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord Vivant — Calebasses Teranga{% endblock %}

{% block body %}
<!-- Zone 1 : En-tête Culturel & Profil -->
<div class="row align-items-center mb-4 g-3">
    <div class="col-md-8 d-flex align-items-center gap-3">
        <div class="avatar-rond avatar-rond-lg">
            <span>AF</span>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="mb-0 fw-bold">Dalal ak Jàmm, Administrateur</h2>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">● En ligne</span>
            </div>
            <p class="text-muted mb-0">Coordination nationale des Groupements de Promotion Féminine (GPF)</p>
        </div>
    </div>
    <div class="col-md-4 text-md-end">
        <button class="btn btn-teranga-gold shadow-sm d-inline-flex align-items-center gap-2" title="Commandes vocales en Wolof">
            <i class="bi bi-mic-fill fs-5"></i>
            <span>Micro Vocal Wolof</span>
        </button>
    </div>
</div>

<!-- Zone 2 : Le Cœur Visuel (Agrégat de la Calebasse 2.5D) -->
<div class="card card-teranga mb-5 overflow-hidden border-0" style="background: linear-gradient(135deg, #0B4F30 0%, #073822 60%, #173B2B 100%); color: #FFFFFF;">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge badge-gold mb-3 text-uppercase px-3 py-2">
                    <i class="bi bi-stars me-1"></i> Trésorerie Globale Fédérée
                </span>
                <div class="text-white-50 text-uppercase fw-bold letter-spacing-1 small">Solde Total des Caisses Sociales</div>
                <div class="montant-geant text-warning my-2" style="font-size: clamp(2.5rem, 5vw, 3.8rem); color: var(--or-souki) !important;">
                    {{ total_caisse }}
                </div>
                <p class="text-light opacity-75 mb-4" style="max-width: 500px;">
                    Fonds de prévoyance solidaire alimenté par les cotisations de présence, les pénalités de retard et les intérêts communautaires.
                </p>

                <div class="d-flex flex-wrap gap-4 pt-3 border-top border-success-subtle">
                    <div>
                        <div class="fs-4 fw-bold text-white">{{ total_groupements }}</div>
                        <div class="text-white-50 small">Groupements Actifs</div>
                    </div>
                    <div class="vr bg-light opacity-25"></div>
                    <div>
                        <div class="fs-4 fw-bold text-white">{{ total_membres }}</div>
                        <div class="text-white-50 small">Femmes Adhérentes</div>
                    </div>
                    <div class="vr bg-light opacity-25"></div>
                    <div>
                        <div class="fs-4 fw-bold text-white">{{ total_campagnes }}</div>
                        <div class="text-white-50 small">Campagnes Ouvertes</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <!-- Calebasse 2.5D Stylisée SVG -->
                <div class="position-relative d-inline-block">
                    <svg width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="filter-drop-shadow">
                        <circle cx="100" cy="100" r="95" fill="rgba(221, 161, 94, 0.15)" stroke="#DDA15E" stroke-width="2" stroke-dasharray="6 6"/>
                        <!-- Corps Calebasse -->
                        <path d="M50 140 C50 170 150 170 150 140 C150 115 125 105 125 80 C125 65 140 55 100 55 C60 55 75 65 75 80 C75 105 50 115 50 140 Z" fill="#BC6C25" stroke="#DDA15E" stroke-width="3"/>
                        <!-- Liquide Doré intérieur -->
                        <path d="M60 140 C60 162 140 162 140 140 C140 125 120 115 120 100 C100 100 80 100 80 100 C80 115 60 125 60 140 Z" fill="#DDA15E" opacity="0.85"/>
                        <!-- Motifs traditionnels -->
                        <circle cx="100" cy="130" r="8" fill="#0B4F30"/>
                        <circle cx="85" cy="138" r="5" fill="#0B4F30"/>
                        <circle cx="115" cy="138" r="5" fill="#0B4F30"/>
                    </svg>
                    <div class="mt-2 text-warning fw-bold small text-uppercase letter-spacing-1">
                        <i class="bi bi-shield-lock-fill me-1"></i> Calebasse Sécurisée
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Zone 3 : Liste des Groupements Communautaires -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Groupements Communautaires (GPF)</h3>
        <p class="text-muted mb-0">Sélectionnez une communauté pour gérer ses exercices, ses membres et ses séances.</p>
    </div>
    <span class="badge bg-dark rounded-pill px-3 py-2">{{ groupements|length }} enregistrés</span>
</div>

<div class="row g-4">
    {% for g in groupements %}
        <div class="col-md-6 col-lg-4">
            <div class="card card-teranga h-100 d-flex flex-column">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-rond">
                                {{ g.initiales }}
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">{{ g.nom }}</h5>
                                <small class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Région Thiès / Dakar</small>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted small mb-3 flex-grow-0" style="min-height: 40px;">
                        {{ g.description|default('Groupement solidaire de femmes pour l\'épargne et l\'entraide locale.') }}
                    </p>

                    <!-- Exercice en cours (Isolé par le Service & DTO) -->
                    <div class="p-2 mb-3 rounded-3" style="background-color: var(--fond-ecru); border: 1px dashed var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-muted text-uppercase" style="font-size: 0.75rem;">Cycle Actuel</span>
                            {% if g.exerciceEnCours %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                    {{ g.exerciceEnCours.statutLabel }}
                                </span>
                            {% else %}
                                <span class="badge bg-secondary rounded-pill">Aucun cycle actif</span>
                            {% endif %}
                        </div>
                        <div class="fw-semibold small text-dark mt-1">
                            {% if g.exerciceEnCours %}
                                <i class="bi bi-calendar-check text-success me-1"></i>{{ g.exerciceEnCours.labelPeriode }}
                            {% else %}
                                <em>En attente d'ouverture</em>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Métriques du groupement -->
                    <div class="border-top pt-3 mt-auto">
                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                            <span class="text-muted small">Caisse Sociale :</span>
                            <span class="fw-bold text-success fs-5">{{ g.soldeCaisseSociale }}</span>
                        </div>

                        <div class="d-flex justify-content-between text-muted small mb-3">
                            <span><i class="bi bi-people-fill me-1 text-primary"></i><strong>{{ g.nombreMembres }}</strong> membres</span>
                            <span><i class="bi bi-piggy-bank-fill me-1 text-warning"></i><strong>{{ g.nombreCampagnes }}</strong> activités</span>
                        </div>

                        <a href="{{ path('app_groupement_show', {id: g.id}) }}" class="btn btn-teranga-primary w-100 d-flex justify-content-center align-items-center gap-2">
                            <span>Ouvrir l'Espace Groupement</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="card card-teranga text-center p-5">
                <i class="bi bi-inbox fs-1 text-muted mb-2"></i>
                <h5>Aucun groupement enregistré</h5>
                <p class="text-muted">Les données initiales n'ont pas encore été chargées.</p>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
