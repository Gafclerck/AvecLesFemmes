{% extends 'base.html.twig' %}

{% block title %}{{ groupement.nom }} — Calebasses{% endblock %}

{% block body %}
<!-- Fil d'Ariane -->
<nav class="breadcrumb-teranga" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="{{ path('app_groupement_index') }}"><i class="bi bi-house-door-fill me-1"></i>Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_groupement_index') }}">Groupements</a></li>
        <li class="breadcrumb-item active text-dark" aria-current="page">{{ groupement.nom }}</li>
    </ol>
</nav>

<!-- En-tête Groupement & Caisse Sociale (Synthèse binaire nette) -->
<div class="row g-4 mb-5">
    <!-- Fiche d'identité du groupement -->
    <div class="col-lg-7">
        <div class="card card-teranga p-4 h-100">
            <div class="d-flex align-items-start gap-3">
                <div class="avatar-rond avatar-rond-lg">
                    {{ groupement.initiales }}
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h2 class="fw-bold mb-0 text-dark">{{ groupement.nom }}</h2>
                        {% if groupement.exerciceEnCours %}
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-clock-history me-1"></i> {{ groupement.exerciceEnCours.statutLabel }}
                            </span>
                        {% endif %}
                    </div>
                    <p class="text-muted mt-2 mb-3">
                        {{ groupement.description|default('Groupement solidaire d\'épargne et d\'entraide communautaire.') }}
                    </p>
                    <div class="d-flex flex-wrap gap-3 text-muted small">
                        <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>Région de Thiès / Dakar</span>
                        <span><i class="bi bi-people-fill text-primary me-1"></i><strong>{{ groupement.membres|length }}</strong> membres</span>
                        <span><i class="bi bi-activity text-warning me-1"></i><strong>{{ groupement.campagnes|length }}</strong> activités financières</span>
                    </div>
                </div>
            </div>

            <!-- Cycle budgétaire actif -->
            {% if groupement.exerciceEnCours %}
                <div class="mt-4 p-3 rounded-3" style="background-color: var(--fond-ecru); border-left: 4px solid var(--vert-calebasse);">
                    <div class="fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-event-fill text-success"></i>
                        <span>{{ groupement.exerciceEnCours.labelPeriode }}</span>
                    </div>
                    <div class="d-flex flex-wrap gap-4 mt-2 text-muted small">
                        {% if groupement.exerciceEnCours.dateLimitePret %}
                            <span>
                                Limite des prêts : <strong>{{ groupement.exerciceEnCours.dateLimitePret }}</strong>
                                {% if groupement.exerciceEnCours.joursRestants is not null %}
                                    <span class="badge {% if groupement.exerciceEnCours.joursRestants > 15 %}bg-success-subtle text-success border border-success-subtle{% elseif groupement.exerciceEnCours.joursRestants >= 0 %}bg-warning-subtle text-warning-emphasis border border-warning-subtle{% else %}bg-danger-subtle text-danger border border-danger-subtle{% endif %} rounded-pill ms-1">
                                        {% if groupement.exerciceEnCours.joursRestants > 0 %}
                                            {{ groupement.exerciceEnCours.joursRestants }} j restant{{ groupement.exerciceEnCours.joursRestants > 1 ? 's' : '' }}
                                        {% elseif groupement.exerciceEnCours.joursRestants == 0 %}
                                            Dernier jour
                                        {% else %}
                                            Clôturé
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </span>
                        {% endif %}
                        {% if groupement.exerciceEnCours.dateRetribution %}
                            <span>Rétribution / Partage : <strong>{{ groupement.exerciceEnCours.dateRetribution }}</strong></span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Caisse Sociale / Fonds de secours -->
    <div class="col-lg-5">
        <div class="card card-teranga p-4 h-100" style="background: linear-gradient(145deg, #FFFFFF 0%, var(--or-souki-light) 100%);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge badge-gold text-uppercase">Caisse Sociale & Secours</span>
                <i class="bi bi-safe2-fill fs-3 text-warning"></i>
            </div>

            <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mt-2">Solde Total Disponible</div>
            <div class="montant-geant text-success my-2">
                {{ groupement.soldeCaisseSociale }}
            </div>
            <p class="text-muted small mb-3">Fonds communautaire de réserve pour imprévus, santé et cérémonies.</p>

            <div class="border-top border-warning-subtle pt-3">
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted"><i class="bi bi-check2-circle text-success me-1"></i>Cotisations présence :</span>
                    <strong class="text-dark">{{ groupement.totalCotisationsCaisse }}</strong>
                </div>
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted"><i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Amendes de retard :</span>
                    <strong class="text-dark">{{ groupement.totalAmendes }}</strong>
                </div>
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted"><i class="bi bi-percent text-info me-1"></i>Intérêts des prêts :</span>
                    <strong class="text-dark">{{ groupement.totalInterets }}</strong>
                </div>
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted"><i class="bi bi-tools text-secondary me-1"></i>Locations matériels :</span>
                    <strong class="text-dark">{{ groupement.totalLocations }}</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section 1 : Activités Financières (Campagnes) sous forme de TABLEAU -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Activités Financières (Campagnes)</h3>
            <p class="text-muted small mb-0">Calebasse d'épargne hebdomadaire et tontines rotatives du groupement</p>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
            {{ groupement.campagnes|length }} activités ouvertes
        </span>
    </div>

    <div class="table-teranga-wrapper">
        <div class="table-responsive">
            <table class="table table-teranga table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Activité</th>
                        <th>Type</th>
                        <th>Rythme & Rencontre</th>
                        <th>Part Calebasse</th>
                        <th>Caisse Sociale</th>
                        <th>Pénalité / jour</th>
                        <th class="text-center">Adhérentes</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in groupement.campagnes %}
                        <tr>
                            <td class="ps-4">
                                <strong class="text-dark fs-6 d-block">{{ c.nom }}</strong>
                                <small class="text-muted">Période : {{ c.dateDebut }} - {{ c.dateFin }}</small>
                            </td>
                            <td>
                                <span class="badge {% if c.type == 'Tontine' %}badge-terre{% else %}badge-vert{% endif %}">
                                    {{ c.type }}
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">{{ c.periodiciteLabel }}</div>
                                <small class="text-muted">Jour : {{ c.jourRencontre }}</small>
                            </td>
                            <td>
                                <strong class="text-success">{{ c.montantFixe }}</strong>
                            </td>
                            <td>
                                <div class="small">Présente : <strong class="text-dark">{{ c.montantCaissePresent }}</strong></div>
                                <div class="small text-muted">Excusée : {{ c.montantCaisseAbsent }}</div>
                            </td>
                            <td>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    {{ c.amendeJournaliere }}
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    <i class="bi bi-people-fill text-primary me-1"></i>{{ c.nombreMembres }}
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a href="{{ path('app_campagne_show', {id: c.id}) }}" class="btn btn-teranga-outline btn-sm d-inline-flex align-items-center gap-1">
                                    <span>Séances & Membres</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Aucune campagne enregistrée pour ce groupement.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Section 2 : Bureau et Membres Adhérentes sous forme de TABLEAU -->
<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Bureau et Membres Adhérentes</h3>
            <p class="text-muted small mb-0">Registre des adhérentes déclarées et des fonctions électives</p>
        </div>
        <span class="badge bg-dark rounded-pill px-3 py-2">{{ groupement.membres|length }} membres</span>
    </div>

    <div class="table-teranga-wrapper">
        <div class="table-responsive">
            <table class="table table-teranga table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Adhérente</th>
                        <th>Rôle au Bureau</th>
                        <th>Responsabilité</th>
                        <th>Téléphone</th>
                        <th>Adresse / Quartier</th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in groupement.membres %}
                        <tr>
                            <td class="ps-4 text-muted fw-bold">{{ loop.index }}</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-rond" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                        {{ m.initiales }}
                                    </div>
                                    <strong class="text-dark">{{ m.nomComplet }}</strong>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    {{ m.fonctionLabel }}
                                </span>
                            </td>
                            <td>
                                {% if m.isGroupOwner %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-star-fill me-1"></i> Leader / Propriétaire
                                    </span>
                                {% else %}
                                    <span class="text-muted small">Adhérente</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="text-muted small font-monospace">
                                    <i class="bi bi-telephone-fill text-secondary me-1"></i>{{ m.telephone }}
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    {{ m.adresse|default('Non renseignée') }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Aucune adhérente enregistrée dans ce groupement.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
