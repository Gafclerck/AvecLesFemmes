{% extends 'base.html.twig' %}

{% block title %}Séance du {{ seance.dateFormatted }} — {{ campagne.nom }}{% endblock %}

{% block body %}
<!-- Fil d'Ariane -->
<nav class="breadcrumb-teranga" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="{{ path('app_groupement_index') }}"><i class="bi bi-house-door-fill me-1"></i>Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_groupement_show', {id: campagne.groupement.id}) }}">{{ campagne.groupement.nom }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_campagne_show', {id: campagne.id}) }}">{{ campagne.nom }}</a></li>
        <li class="breadcrumb-item active text-dark" aria-current="page">Séance du {{ seance.dateFormatted }}</li>
    </ol>
</nav>

<!-- Bilan Financier de la Séance (KPIs Épurés) -->
<div class="card card-teranga p-4 p-md-5 mb-5 border-0 shadow-sm" style="background: linear-gradient(135deg, var(--vert-calebasse) 0%, var(--vert-calebasse-dark) 100%); color: #FFFFFF;">
    <div class="row align-items-center g-4">
        <div class="col-lg-6">
            <span class="badge badge-gold mb-2 text-uppercase px-3 py-2">
                <i class="bi bi-calendar2-check-fill me-1"></i> {{ seance.jourNom }} {{ seance.dateFormatted }}
            </span>
            <div class="text-white-50 text-uppercase fw-bold letter-spacing-1 small">Total Recueilli lors de la Séance</div>
            <div class="montant-geant text-warning my-2" style="font-size: clamp(2.4rem, 4.5vw, 3.4rem); color: var(--or-souki) !important;">
                {{ seance.grandTotal }}
            </div>
            <p class="text-light opacity-75 mb-0" style="max-width: 480px;">
                Versements enregistrés sous le contrôle de la Présidente et de la Trésorière pour la campagne <strong>{{ campagne.nom }}</strong>.
            </p>
        </div>

        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="p-3 rounded-3 text-center" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <div class="text-white-50 small">Épargne Calebasse</div>
                        <div class="fs-5 fw-bold text-white mt-1">{{ seance.totalEpargne }}</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 rounded-3 text-center" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <div class="text-white-50 small">Caisse Sociale</div>
                        <div class="fs-5 fw-bold text-warning mt-1">{{ seance.totalCaisse }}</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 rounded-3 text-center" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <div class="text-white-50 small">Total Amendes</div>
                        <div class="fs-5 fw-bold text-danger-emphasis mt-1">{{ seance.totalAmendes }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Registre de Séance & Appel des Membres sous forme de TABLEAU -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-0">Registre des Cotisations de Séance</h3>
            <p class="text-muted small mb-0">Appel nominal et comptabilisation des versements par adhérente</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                🟢 {{ seance.nbPresents }} Présentes
            </span>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2">
                🟡 {{ seance.nbAbsentsAvecFonds }} Excusées (+fonds)
            </span>
            {% if seance.nbAbsentsNonPayes > 0 %}
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">
                    🔴 {{ seance.nbAbsentsNonPayes }} Absentes non payées
                </span>
            {% endif %}
        </div>
    </div>

    <div class="table-teranga-wrapper">
        <div class="table-responsive">
            <table class="table table-teranga table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Adhérente</th>
                        <th>Rôle au Bureau</th>
                        <th>Statut Présence</th>
                        <th>Épargne Calebasse</th>
                        <th>Cotisation Caisse</th>
                        <th>Total Versé</th>
                        <th class="pe-4">Pénalité / Amende</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in seance.cotisations %}
                        <tr class="{% if c.statutPresence == 'ABSENT_NON_PAYE' %}table-danger table-opacity-25{% endif %}">
                            <td class="ps-4 text-muted fw-bold">{{ loop.index }}</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-rond" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                        {{ c.initiales }}
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">{{ c.membreNom }}</strong>
                                        <small class="text-muted font-monospace">{{ c.telephone }}</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary small">
                                    {{ c.fonction|default('Adhérente') }}
                                </span>
                            </td>
                            <td>
                                {% if c.statutPresence == 'PRESENT' %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Présente
                                    </span>
                                {% elseif c.statutPresence == 'ABSENT_AVEC_FONDS' %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-envelope-check-fill me-1"></i> Excusée (+fonds)
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger text-white px-2 py-1">
                                        <i class="bi bi-x-circle-fill me-1"></i> Absente non payée
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">{{ c.montantEpargne }}</span>
                            </td>
                            <td>
                                <span class="text-muted">{{ c.montantCaisse }}</span>
                            </td>
                            <td>
                                <strong class="text-success fs-6">{{ c.montantTotal }}</strong>
                            </td>
                            <td class="pe-4">
                                {% if c.aAmende %}
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            {{ c.amendeMontant }} ({{ c.amendeJours }}j)
                                        </span>
                                        {% if c.amendePayee %}
                                            <span class="badge bg-success text-white small" title="Amende réglée">
                                                <i class="bi bi-check-lg"></i> Réglée
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger text-white small" title="Paiement en attente">
                                                <i class="bi bi-hourglass-split"></i> En attente
                                            </span>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Passeport de Confiance : Reçu Officiel & Partage WhatsApp -->
<div class="card card-teranga p-4 p-md-5 mb-5 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="badge badge-gold mb-1 text-uppercase">Traçabilité & Preuve Sociale</span>
            <h3 class="fw-bold mb-0 text-dark">Passeport de Confiance — Reçu de Séance</h3>
            <p class="text-muted small mb-0">Partage officiel instantané des montants scellés lors de la réunion</p>
        </div>
        <div>
            <a href="https://api.whatsapp.com/send?text={{ ('Reçu Officiel Calebasses - ' ~ campagne.nom ~ ' - Séance du ' ~ seance.dateFormatted ~ ' : Total collecté ' ~ seance.grandTotal ~ ' scellé dans la Calebasse.')|url_encode }}" 
               target="_blank" 
               class="btn btn-success btn-lg rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-whatsapp fs-4"></i>
                <span class="fw-bold">Partager le Reçu sur WhatsApp</span>
            </a>
        </div>
    </div>

    <!-- Reçu Stylisé Épuré -->
    <div class="p-4 rounded-4" style="background-color: var(--fond-ecru); border: 2px solid var(--border-color); max-width: 680px; margin: 0 auto;">
        <div class="text-center pb-3 border-bottom border-dark border-opacity-10">
            <div class="fs-3">🍯</div>
            <h4 class="fw-bold mb-0 text-dark">REÇU OFFICIEL DE COTISATION</h4>
            <div class="text-muted small text-uppercase letter-spacing-1">{{ campagne.groupement.nom }}</div>
        </div>

        <div class="row g-3 my-3 text-center">
            <div class="col-6 border-end">
                <div class="text-muted small">Date de la réunion</div>
                <div class="fw-bold text-dark fs-5">{{ seance.dateFormatted }}</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Membres participantes</div>
                <div class="fw-bold text-dark fs-5">{{ seance.totalMembres }} adhérentes</div>
            </div>
        </div>

        <div class="p-3 my-3 rounded-3 text-center" style="background-color: #FFFFFF; border: 2px solid var(--or-souki);">
            <div class="text-muted small text-uppercase fw-bold">Montant Total Scellé</div>
            <div class="montant-geant text-success my-1">{{ seance.grandTotal }}</div>
            <div class="small text-muted">Épargne : {{ seance.totalEpargne }} | Caisse Sociale : {{ seance.totalCaisse }}</div>
        </div>

        <div class="text-center pt-2">
            <small class="text-muted fst-italic">Document généré automatiquement par la plateforme Calebasses. Fait foi de versement auprès du bureau.</small>
        </div>
    </div>
</div>
{% endblock %}
