<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Calebasses — Avec les Femmes{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍯</text></svg>">

        <!-- Google Fonts: Playfair Display + Plus Jakarta Sans -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        <!-- Bootstrap 5 & Icons -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        <style>
            :root {
                --vert-calebasse: #0B4F30;
                --vert-calebasse-dark: #073822;
                --vert-calebasse-subtle: #E8F3ED;
                --or-souki: #DDA15E;
                --or-souki-light: #FDF4E7;
                --terre-cuite: #BC6C25;
                --blanc-coton: #FEFAE0;
                --fond-ecru: #F9F7F1;
                --texte-sombre: #1A2E22;
                --border-color: #E2DDD5;
            }

            body {
                background-color: var(--fond-ecru);
                font-family: 'Plus Jakarta Sans', sans-serif;
                color: var(--texte-sombre);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            h1, h2, h3, .font-serif {
                font-family: 'Playfair Display', serif;
            }

            /* Navbar Teranga */
            .navbar-teranga {
                background: linear-gradient(135deg, var(--vert-calebasse-dark) 0%, var(--vert-calebasse) 100%);
                border-bottom: 3px solid var(--or-souki);
                box-shadow: 0 4px 15px rgba(11, 79, 48, 0.15);
            }

            .navbar-brand-title {
                font-family: 'Playfair Display', serif;
                font-size: 1.5rem;
                font-weight: 700;
                color: #FFFFFF;
                letter-spacing: 0.5px;
            }

            .badge-gold {
                background-color: var(--or-souki);
                color: #FFFFFF;
                font-weight: 700;
                border-radius: 20px;
                padding: 0.35rem 0.8rem;
            }

            .badge-terre {
                background-color: var(--terre-cuite);
                color: #FFFFFF;
                font-weight: 600;
            }

            .badge-vert {
                background-color: var(--vert-calebasse);
                color: #FFFFFF;
                font-weight: 600;
            }

            /* Cartes & Éléments UI */
            .card-teranga {
                background: #FFFFFF;
                border: 1px solid var(--border-color);
                border-radius: 18px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .card-teranga:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(11, 79, 48, 0.08);
            }

            .montant-geant {
                font-size: 2.25rem;
                font-weight: 800;
                color: var(--vert-calebasse);
                letter-spacing: -0.5px;
                line-height: 1.1;
            }

            .montant-or {
                color: var(--terre-cuite);
                font-size: 1.85rem;
                font-weight: 800;
            }

            /* Boutons Teranga */
            .btn-teranga-primary {
                background-color: var(--vert-calebasse);
                color: #FFFFFF;
                font-weight: 700;
                border-radius: 12px;
                padding: 0.65rem 1.4rem;
                border: none;
                transition: background-color 0.2s;
            }

            .btn-teranga-primary:hover {
                background-color: var(--vert-calebasse-dark);
                color: #FFFFFF;
            }

            .btn-teranga-gold {
                background-color: var(--or-souki);
                color: #FFFFFF;
                font-weight: 700;
                border-radius: 12px;
                padding: 0.65rem 1.4rem;
                border: none;
            }

            .btn-teranga-gold:hover {
                background-color: #c98e4c;
                color: #FFFFFF;
            }

            .btn-teranga-outline {
                background-color: transparent;
                color: var(--vert-calebasse);
                border: 2px solid var(--vert-calebasse);
                font-weight: 700;
                border-radius: 12px;
                padding: 0.6rem 1.3rem;
            }

            .btn-teranga-outline:hover {
                background-color: var(--vert-calebasse);
                color: #FFFFFF;
            }

            /* Avatar rond */
            .avatar-rond {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--vert-calebasse), var(--or-souki));
                color: #FFFFFF;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 1.1rem;
                box-shadow: 0 2px 8px rgba(11, 79, 48, 0.2);
            }

            .avatar-rond-lg {
                width: 72px;
                height: 72px;
                font-size: 1.6rem;
                border: 3px solid var(--or-souki);
            }

            /* Sceau traditionnel africain */
            .sceau-confiance {
                border: 2px dashed var(--vert-calebasse);
                border-radius: 12px;
                background-color: var(--vert-calebasse-subtle);
                padding: 0.8rem 1.2rem;
                display: inline-flex;
                align-items: center;
                gap: 0.75rem;
            }

            /* Breadcrumb personnalisé */
            .breadcrumb-teranga {
                background: transparent;
                padding: 0.75rem 0;
                margin-bottom: 1.5rem;
                font-size: 0.95rem;
                font-weight: 600;
            }

            .breadcrumb-teranga a {
                color: var(--vert-calebasse);
                text-decoration: none;
            }

            .breadcrumb-teranga a:hover {
                text-decoration: underline;
            }

            /* Footer */
            footer {
                margin-top: auto;
                background: #FFFFFF;
                border-top: 1px solid var(--border-color);
                padding: 1.5rem 0;
                font-size: 0.9rem;
                color: #6C757D;
            }
        </style>

        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <!-- Header / Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark navbar-teranga sticky-top py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_groupement_index') }}">
                    <span style="font-size: 1.8rem;">🍯</span>
                    <div>
                        <div class="navbar-brand-title">CALEBASSES</div>
                        <small style="color: var(--or-souki-light); font-size: 0.72rem; letter-spacing: 1px; text-transform: uppercase;">Épargne & Tontine des Femmes</small>
                    </div>
                </a>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge badge-gold d-none d-sm-inline-flex align-items-center gap-1">
                        <i class="bi bi-shield-check"></i> Super-Admin
                    </span>
                    <a href="{{ path('app_groupement_index') }}" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-grid-fill me-1"></i> Groupements
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="py-4">
            <div class="container">
                {% block body %}{% endblock %}
            </div>
        </main>

        <!-- Footer -->
        <footer class="text-center">
            <div class="container">
                <p class="mb-1 fw-semibold text-dark">Application « Avec les Femmes » — Gestion des Groupements & Calebasse Solidaire</p>
                <small class="text-muted">Système de Design <strong>Teranga-Fintech</strong> — Dakar / Thiès, Sénégal</small>
            </div>
        </footer>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
